[Unit]
Description=MuSync multi-device audio sync hub
After=network-online.target sound.target pipewire.service bluetooth.service
Wants=network-online.target bluetooth.service

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/MuSync
Environment=MUSYNC_BACKEND=pipewire
Environment=MUSYNC_HOST=0.0.0.0
Environment=MUSYNC_PORT=8080
# Spotify OAuth default for Pi — 127.0.0.1:8080 (not localhost / musync.local).
# Override via ~/musync.env if needed; laptop :8081 is a mock override only.
Environment=MUSYNC_SPOTIFY_REDIRECT_URI=http://127.0.0.1:8080/api/streaming/spotify/callback
Environment=MUSYNC_MEDIA_DIR=/home/pi/MuSync/media
Environment=MUSYNC_DEVICES_CONFIG=/home/pi/MuSync/config/devices.yaml
Environment=MUSYNC_WEB_DIR=/home/pi/MuSync/web/build
Environment=MUSYNC_PW_FEEDER=musync_feeder
Environment=MUSYNC_PW_DRY_RUN=0
Environment=PYTHONPATH=/home/pi/MuSync/backend
# cargo install librespot + pipx yt-dlp (login shells usually have these; systemd does not).
Environment=PATH=/home/pi/.cargo/bin:/home/pi/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# Prefer: EnvironmentFile=-/home/pi/musync.env
# HDMI/console: big LAN URL + printable QR before API listen (soft-fail OK).
ExecStartPre=-/usr/bin/python3 -m musync.lan_banner --console
ExecStart=/usr/bin/python3 -m musync
# Allow FastAPI lifespan to unload MuSync loopbacks/feeder + stop children.
TimeoutStopSec=15
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
