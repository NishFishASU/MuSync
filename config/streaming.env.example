# Copy to ~/musync.env (Windows: %USERPROFILE%\musync.env) or
# config/streaming.local.env — never commit real values.
# Prefer Streaming UI → Save to musync.env (API masks secrets; never logs them).
# First UI save creates ~/musync.env and seeds MUSYNC_PORT + redirect below;
# later saves never overwrite existing PORT/redirect unless you edit them.
# run_pi.sh / run_dev.sh / API startup auto-load these files.
# Login is OAuth Connect in the UI (redirect) — not a password form.
# Lines may use KEY=value or export KEY=value (Windows-friendly KEY=value preferred).
# Empty keys soft-fail (local / AirPlay still work).
# Never use an empty port (http://127.0.0.1:/… is refused — default 8080).

# API listen port (Pi + laptop default). Override to 8081 when 8080 is taken.
MUSYNC_PORT=8080

# --- Spotify (full hub playback via librespot → musync_feeder) ---
MUSYNC_SPOTIFY_CLIENT_ID=
MUSYNC_SPOTIFY_CLIENT_SECRET=
# Must match ONE Spotify Developer Dashboard redirect URI exactly (API port, not Vite :5173).
# Register BOTH of these in the Dashboard (Spotify allows multiple):
#   http://127.0.0.1:8080/api/streaming/spotify/callback   ← Pi + laptop default (MUSYNC_PORT=8080)
#   http://127.0.0.1:8081/api/streaming/spotify/callback   ← laptop override when 8080 is busy
# Pi: keep the 8080 line below (run_pi.sh / systemd also default to it).
# Laptop: set MUSYNC_PORT=8081 and switch this URI to :8081 when needed.
# Spotify forbids localhost and *.local — do NOT use localhost or musync.local here.
# (musync.local is UI mDNS only — open http://musync.local:8080 in a browser.)
# Pi OAuth from another device: http://<Pi-IP>:8080/api/streaming/spotify/callback (add that URI too).
MUSYNC_SPOTIFY_REDIRECT_URI=http://127.0.0.1:8080/api/streaming/spotify/callback
# Catalog search market (ISO country). Never use from_token — causes 403 Insufficient client scope.
# MUSYNC_SPOTIFY_MARKET=US
# Dev Mode /search max results per request is 10 (15+ → 400 Invalid limit). Extended Quota → 50.
# MUSYNC_SPOTIFY_SEARCH_MAX=10
# MUSYNC_SPOTIFY_TOKEN_PATH=
# MUSYNC_LIBRESPOT_BIN=librespot
# MUSYNC_LIBRESPOT_NAME=MuSync
# MUSYNC_LIBRESPOT_BITRATE=160

# --- AirPlay receive (shairport-sync → PipeWire → musync_feeder) ---
# No MusicKit / Apple Music catalog search on the hub — see docs/airplay-receive.md
# MUSYNC_AIRPLAY_SOURCE=shairport-sync
# MUSYNC_AIRPLAY_NAME=MuSync
# Legacy alias still accepted:
# MUSYNC_APPLE_AIRPLAY_SOURCE=shairport-sync

# --- YouTube (Data API search + yt-dlp|-g|ffmpeg → musync_feeder) ---
# Create a key at console.cloud.google.com with YouTube Data API v3 enabled.
# See docs/youtube.md
MUSYNC_YOUTUBE_API_KEY=
# MUSYNC_YTDLP_BIN=yt-dlp
# MUSYNC_FFMPEG_BIN=ffmpeg
# Optional: cookies when yt-dlp hits YouTube bot / age gates (play soft-fails with a clear note).
# MUSYNC_YTDLP_COOKIES=/home/pi/youtube-cookies.txt
# MUSYNC_YTDLP_COOKIES_FROM_BROWSER=chromium
# MUSYNC_YTDLP_EXTRA_ARGS=

# --- Optional ---
# MUSYNC_PW_FEEDER=musync_feeder
# MUSYNC_STREAMING_MOCK=0
