# Copy to ~/musync.env (or config/streaming.local.env) — never commit real values.
# ./scripts/run_pi.sh auto-sources ~/musync.env.
# Login is OAuth Connect in the UI (redirect) — not a password form.

# --- Spotify (full hub playback via librespot → musync_feeder) ---
MUSYNC_SPOTIFY_CLIENT_ID=
MUSYNC_SPOTIFY_CLIENT_SECRET=
# Must match Spotify Developer Dashboard redirect URI (use Pi LAN IP on device):
MUSYNC_SPOTIFY_REDIRECT_URI=http://127.0.0.1:8080/api/streaming/spotify/callback
# MUSYNC_SPOTIFY_TOKEN_PATH=
# MUSYNC_LIBRESPOT_BIN=librespot
# MUSYNC_LIBRESPOT_NAME=MuSync
# MUSYNC_LIBRESPOT_BITRATE=160

# --- Apple Music (search + optional AirPlay capture; limited on Linux) ---
# MUSYNC_APPLE_TEAM_ID=
# MUSYNC_APPLE_KEY_ID=
# MUSYNC_APPLE_PRIVATE_KEY_PATH=/home/pi/keys/AuthKey_XXXXX.p8
# MUSYNC_APPLE_STOREFRONT=us
# MUSYNC_APPLE_MUSIC_USER_TOKEN=
# MUSYNC_APPLE_AIRPLAY_SOURCE=

# --- Optional ---
# MUSYNC_PW_FEEDER=musync_feeder
# MUSYNC_STREAMING_MOCK=0
